{
  "name": "@time-buddy/core",
  "version": "0.2.0",
  "description": "Core parser and evaluator for time-buddy expressions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/grammar/tb.ohm','dist/grammar/tb.ohm')\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "luxon": "^3.4.0",
    "ohm-js": "^17.1.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.0",
    "vitest": "^1.6.0",
    "typescript": "^5.4.0"
  }
}
