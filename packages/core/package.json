{
  "name": "@time-buddy/core",
  "version": "0.2.0",
  "description": "Core parser and evaluator for time-buddy date/time expressions",
  "type": "module",
  "license": "MIT",
  "author": "Matthew C. Walker",
  "homepage": "https://github.com/matsaleh13/time-buddy-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matsaleh13/time-buddy-cli.git"
  },
  "keywords": ["time", "date", "datetime", "duration", "arithmetic", "parser"],
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/grammar/tb.ohm','dist/grammar/tb.ohm')\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "luxon": "^3.4.0",
    "ohm-js": "^17.1.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.0",
    "@vitest/coverage-v8": "^1.6.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
